PORT=4000
FIONA_AUTH_URL=https://fiona.nova.gr/gateway/FionaAuthAPI/1.0/fiona/GR/auth/login
FIONA_ORDERS_URL=https://fiona.nova.gr/gateway/FionaWebAPI/1.0/fionaWeb/orders/filter
FIONA_WORKORDERS_URL=https://fiona.nova.gr/gateway/FionaWebAPI/1.0/fionaWeb/GR/workorders
# FIONA_USERNAME is retained as the Alexandroupoli username for compatibility.
FIONA_USERNAME=your_alexandroupoli_username@example.com
FIONA_KOMOTINI_USERNAME=your_komotini_username@example.com
FIONA_ORESTIADA_USERNAME=your_orestiada_username@example.com
FIONA_PASSWORD=replace_locally
FIONA_BASIC_AUTH=paste_base64_value_without_Basic_prefix
# Set per-store Basic Auth only if Fiona requires different values per account.
# FIONA_ALEXANDROUPOLI_BASIC_AUTH=
# FIONA_KOMOTINI_BASIC_AUTH=
# FIONA_ORESTIADA_BASIC_AUTH=
APP_PASSWORD=choose_a_separate_app_password
PROJECT_TRACKER_SESSION_SECRET=choose_a_separate_random_secret
# JSON keys use "storeId|Fiona teamName"; only listed teams can correct imported jobs.
PROJECT_TRACKER_TEAM_PASSWORDS={"alexandroupoli|Stavros Venetis, alexandroupoli|Christos Paschalakis komotini|Giorgos Tzitziesvili":"replace_locally"}
# Separate password for the tracker administrator who reviews and locks monthly payments.
PROJECT_TRACKER_ADMIN_PASSWORD=replace_locally
# Map exact Fiona order/category labels or IDs to tracker category IDs.
PROJECT_TRACKER_CATEGORY_MAP={"FTTH Activation":"ftth_installation","On-Site Support FTTH":"all_impairments","CPE Installation FWA":"fwa_installation","NGA Activation":"ftth_installation","On-Site Support NGA":"all_impairments","On-Site Support DTH TV":"dth_tv_impairment","CPE Installation":"copper_installation","On-Site Support LLU":"all_impairments","Combined Wind-AP":"all_impairments","Cabling repair and maintenance":"copper_installation","On-Site Support FWA":"all_impairments","SI Bridging":"all_impairments","Combined Visit OTE-WIND":"all_impairments","CO Visit":"all_impairments","CPE Installation DTH TV":"dth_tv_installation","CPE Installation NGA":"ftth_installation","CPE Installation LLU":"copper_installation","Combined LLU Visit OTE-WIND":"all_impairments"}
PROJECT_TRACKER_SYNC_INTERVAL_MS=900000
PROJECT_TRACKER_LOOKBACK_DAYS=14
FIONA_COUNTRY_CODE=GR
FIONA_FILTER_LIMIT=100
FIONA_FILTER_OFFSET=-1
FIONA_FILTER_STATUSES=OPEN,TO CALL,APPOINTMENT,CALL LATER
POLL_INTERVAL_MS=300000
FIONA_CLOSED_SERVICE_GROUPS=395
# Optional per-store service group IDs (comma-separated); each store falls back to the list above.
# FIONA_KOMOTINI_CLOSED_SERVICE_GROUPS=
# FIONA_ORESTIADA_CLOSED_SERVICE_GROUPS=
# Orders are also kept only if the service group name in the order details contains the store keyword.
# FIONA_ALEXANDROUPOLI_SERVICE_GROUP_MATCH=
# FIONA_KOMOTINI_SERVICE_GROUP_MATCH=
# FIONA_ORESTIADA_SERVICE_GROUP_MATCH=
FIONA_REQUEST_MIN_DELAY_MS=1000
FIONA_REQUEST_MAX_DELAY_MS=2500
CLOSED_TICKETS_DB_PATH=
